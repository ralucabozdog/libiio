menuconfig LIBIIO
	bool "libiio support"
	depends on POSIX_API
	help
	  This option enables the libiio library.

if LIBIIO

module = LIBIIO
module-str = libiio
source "subsys/logging/Kconfig.template.log_config"

config LIBIIO_LOG_MSG_SIZE
	int "Maximum length of a single libiio log message (bytes)"
	default 128
	help
	  Each call to zephyr iio_prm_printf() formats the message into a stack-
	  allocated buffer of this size before handing it to the Zephyr
	  logging subsystem. Increase this value if libiio log messages are
	  being truncated.

config LIBIIO_IIOD_V0_COMPAT
	bool "libiio v0.x (ASCII protocol) compatibility"
	default y
	help
	  Make the iiod server understand the line-based ASCII command
	  protocol used by libiio v0.x clients, in addition to the binary
	  protocol used by v1.x clients. The client is detected automatically:
	  a v1 client's first command is "BINARY", which switches the server
	  to the binary protocol; a v0 client stays on the ASCII protocol.

	  Disable this to build a binary-only (v1) server.

rsource "drivers/Kconfig"
rsource "iiod/Kconfig"

endif # LIBIIO
