/ {
	iio-context {
		iio-adcs {
			ad4052 {
				compatible = "iio,io-channels";
				io-channels = <&adc4052_eval_ad4052_ardz 0>;
				io-channel-names = "adc_in_ch0";
				io-name = "ad4052";
				buffer-name = "buffer0";
				trigger-device = <&trigger_ad4052>;
			};

			trigger_ad4052: trigger_ad4052 {
				compatible = "iio,trigger-timer";
				io-name = "trigger_timer0";
				trigger-id = "trigger0";
			};
		};
	};
};
