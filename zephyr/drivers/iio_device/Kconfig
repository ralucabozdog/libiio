menuconfig LIBIIO_IIO_DEVICE
	bool "IIO device drivers"
	default y
	help
	  Enable IIO device drivers

if LIBIIO_IIO_DEVICE

config LIBIIO_IIO_DEVICE_FP
	bool "Support full floating-point operation"
	select REQUIRES_FULL_LIBC
	help
	  Enable full floating point support, for inputs/outputs

config LIBIIO_IIO_DEVICE_ADC
	bool "ADC IIO device driver"
	default y
	depends on DT_HAS_IIO_ADC_ENABLED && ADC
	help
	  Enable the IIO ADC device driver.

config LIBIIO_IIO_DEVICE_ADC_INIT_PRIORITY
	int "ADC IIO device driver init priority"
	default 50
	depends on LIBIIO_IIO_DEVICE_ADC
	help
	  Initialization priority of the IIO ADC device driver.

config LIBIIO_IIO_DEVICE_IO_CHANNELS
	bool "ADC/DAC IO channels driver"
	default y
	depends on DT_HAS_IIO_IO_CHANNELS_ENABLED && (ADC || DAC)
	help
	  Enable the Zephyr ADC/DAC io channels iio device driver class.

config LIBIIO_IIO_DEVICE_IO_CHANNELS_INIT_PRIORITY
	int "ADC driver init priority"
	default KERNEL_INIT_PRIORITY_DEVICE
	depends on LIBIIO_IIO_DEVICE_IO_CHANNELS
	help
	  Initialization priority of the Zephyr ADC/DAC io-channels iio device driver class.

config LIBIIO_IIO_DEVICE_SENSOR
	bool "Sensor driver"
	default y
	depends on DT_HAS_IIO_SENSOR_ENABLED && SENSOR
	help
	  Enable the Zephyr Sensor iio device driver class.

config LIBIIO_IIO_DEVICE_SENSOR_INIT_PRIORITY
	int "Sensor driver init priority"
	default 90
	depends on LIBIIO_IIO_DEVICE_SENSOR
	help
	  Initialization priority of the Zephyr Sensor iio device driver class.
	  Has to be higher than the initialization priority of the sensor drivers.

config LIBIIO_IIO_DEVICE_TRIGGER_INIT_PRIORITY
	int "Trigger driver init priority"
	default KERNEL_INIT_PRIORITY_DEVICE
	help
	  Initialization priority of the Zephyr Trigger iio device driver class.
	  Has to be same or higher than the initialization priority of the io-channel iio
	  device drivers.

endif # LIBIIO_IIO_DEVICE
