/* Use IO0, IO1 and IO2 of the MikroE ADAC Click as ADC inputs only; IO3 stays a DAC output */

/ {
	iio-context {
		ad5593r {
			io-channels = <&ad5593_adc_mikroe_adac_click 0
				       &ad5593_adc_mikroe_adac_click 1
				       &ad5593_adc_mikroe_adac_click 2
				       &ad5593_dac_mikroe_adac_click 3>;
			io-channel-names = "voltage0",
					   "voltage1",
					   "voltage2",
					   "voltage3";
		};
	};
};
