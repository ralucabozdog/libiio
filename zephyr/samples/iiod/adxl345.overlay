#include <zephyr/dt-bindings/sensor/adxl345.h>
#include <dt-bindings/iio/sensor-channels.h>

/ {
	/* IIO Context for libiio */
	iio-context {
		iio-sensors {
			/* ADXL345 3-axis Accelerometer */
			adxl345 {
				compatible = "iio,sensor";
				sensor-device = <&adxl345_pmod_acl>;
				sensor-channels = <
					IIO_SENSOR_CHAN_ACCEL_X
					IIO_SENSOR_CHAN_ACCEL_Y
					IIO_SENSOR_CHAN_ACCEL_Z
				>;
				buffer-name = "buffer0";
				io-name = "adxl345";

				trigger_adxl345 {
					compatible = "iio,trigger-sensor";
					io-name = "trigger_sensor0";
					trigger-id = "trigger1";
				};
			};
		};
	};
};
