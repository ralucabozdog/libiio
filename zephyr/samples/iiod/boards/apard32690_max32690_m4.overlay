/ {
	iio-context {
		#address-cells = <1>;
		#size-cells = <0>;

		iio-device@0 {
			compatible = "iio,adc";
			reg = <0>;
			io-channels = <&adc 0>;
			io-channel-names = "adc_in_ch0";
		};
	};
};

&adc {
	pinctrl-0 = <&ain0_p3_0>;
	pinctrl-names = "default";
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};