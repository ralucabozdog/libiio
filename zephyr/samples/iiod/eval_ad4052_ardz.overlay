/ {
	iio-context {
		#address-cells = <1>;
		#size-cells = <0>;

		iio-device@0 {
			compatible = "iio,io-channels";
			reg = <0>;
			io-channels = <&adc4052_eval_ad4052_ardz 0>;
			io-channel-names = "adc_in_ch0";
			trigger-device = <&trigger0>;
		};

		trigger0: iio-device@1 {
			compatible = "iio,trigger-timer";
			reg = <1>;
			trigger-id = "trigger0";
			trigger-type = "timer";
		};
	};
};
